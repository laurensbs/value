{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "mcp__Vercel",
      "mcp__github",
      "mcp__claude-code-remote"
    ],
    "ask": [
      "mcp__Vercel__buy_addon",
      "mcp__Vercel__buy_credits",
      "mcp__Vercel__buy_credits_endpoint",
      "mcp__Vercel__buy_domain",
      "mcp__Vercel__buy_domains",
      "mcp__Vercel__buy_pro",
      "mcp__Vercel__buy_single_domain",
      "mcp__Vercel__create_or_transfer_domain",
      "mcp__Vercel__delete_project",
      "mcp__Vercel__pause_project"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./web/.env)",
      "Read(./web/.env.*)"
    ]
  }
}
