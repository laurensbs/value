        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment ça marche pour les propriétaires"
          }
        }
      }
    },
    "Zo zie je hoe %@ met %@ omgaat." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That way you see how %@ gets on with %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así ves cómo %@ se lleva con %@."
          }
        },
        "fr" : {
          "stringUnit" : {
