    "Vraag of de wandelaar een foto stuurt. Dan wandel je in gedachten een beetje mee." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the walker to send a photo. Then you walk along a little in your mind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide al paseador que envíe una foto. Así paseas un poco con ellos en tu mente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande au promeneur d'envoyer une photo. Tu te promènes un peu avec eux en pensée."
          }
        }
      }
    },
    "Vuurwerk is eng voor honden. Loop kort, aan de lijn en voor het donker." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fireworks are scary for dogs. Walk short, on the lead and before dark."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los fuegos artificiales asustan a los perros. Paseo corto, con correa y antes de que oscurezca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les feux d'artifice font peur aux chiens. Balade courte, en laisse et avant la nuit."
          }
        }
      }
    },
