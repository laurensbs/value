            "value" : "Expérience avec les chiens"
          }
        }
      }
    },
    "Even buiten geweest. Dat telt ook." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You got outside. That counts too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has salido un rato. Eso también cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as pris l'air. Ça compte aussi."
          }
        }
      }
    },
    "Even geen verbinding" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No connection right now"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin conexión ahora mismo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
