    },
    "De eigenaar loopt mee en bekijkt je ID." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The owner walks along and checks your ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dueño camina contigo y comprueba tu documento."
