        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le propriétaire marche avec toi et vérifie ta pièce d'identité."
          }
        }
      }
    },
    "De eigenaar ziet je ID in het echt. %@ bewaart geen kopie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The owner sees your ID in person. %@ keeps no copy."
          }
