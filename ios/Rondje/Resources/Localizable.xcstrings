    },
    "Dat lukte even niet. Controleer je verbinding en probeer het opnieuw." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That didn't work just now. Check your connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
