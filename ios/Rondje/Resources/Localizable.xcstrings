    "Alleen op deze iPhone. %@ leest niets uit Gezondheid en stuurt er niets van naar de server." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only on this iPhone. %@ reads nothing from Health and sends none of it to the server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo en este iPhone. %@ no lee nada de Salud y no envía nada de ello al servidor."
