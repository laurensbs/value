    "Alleen %@ ziet dit, nooit de eigenaar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only %@ sees this, never the owner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo %@ ve esto, nunca el dueño."
