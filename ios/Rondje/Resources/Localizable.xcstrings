    "Geef alleen een koekje als het profiel van de hond zegt dat het mag. Sommige honden mogen niets extra's." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only give a treat if the dog's profile says it's allowed. Some dogs may not have anything extra."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da una golosina solo si el perfil del perro lo permite. Algunos perros no pueden tomar nada extra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne donne une friandise que si le profil du chien le permet. Certains chiens ne doivent rien avoir en plus."
          }
        }
      }
    },
