    "%@ bewaart nooit een kopie van een ID. Zelfstandig wandelen kan pas als %@ ook de veiligheidsquiz heeft gehaald." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ never keeps a copy of an ID. Solo walks are only possible once %@ has also passed the safety quiz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nunca guarda una copia de un documento de identidad. Los paseos en solitario solo son posibles cuando %@ también haya aprobado el test de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne garde jamais de copie d'une pièce d'identité. Les balades en solo ne sont possibles que lorsque %@ a aussi réussi le quiz de sécurité."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ bewaart nooit een kopie van een ID. Zelfstandig wandelen kan pas als %2$@ ook de veiligheidsquiz heeft gehaald."
          }
        }
      }
    },
    "%@ en jij liepen %@. Dank je wel." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ and you walked %@. Thank you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ y tú habéis caminado %@. Gracias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ et toi avez marché %@. Merci."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ en jij liepen %2$@. Dank je wel."
          }
        }
      }
    },
    "%@ is gratis voor wandelaars, eigenaren en opvangen. Leden houden het veilig en online, en een deel gaat naar goede doelen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is free for walkers, owners and shelters. Members keep it safe and online, and part goes to good causes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es gratis para paseadores, dueños y refugios. Los socios lo mantienen seguro y en línea, y una parte va a buenas causas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est gratuit pour les promeneurs, les propriétaires et les refuges. Les membres le gardent sûr et en ligne, et une partie va à de bonnes causes."
          }
        }
      }
    },
