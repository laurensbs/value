        }
      }
    },
    "Er wonen honden bij jou in de buurt. Kijk wie er mee wil." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are dogs living near you. See who wants to come along."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay perros que viven cerca de ti. Mira quién quiere venir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des chiens habitent près de chez toi. Regarde qui veut venir."
          }
        }
      }
    },
    "Er wonen nog geen honden bij jou in de buurt. Een groepswandeling bij een opvang is een fijne start." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No dogs live near you yet. A group walk at a shelter is a lovely start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no hay perros cerca de ti. Un paseo en grupo en un refugio es un buen comienzo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun chien n'habite encore près de chez toi. Une balade en groupe dans un refuge est un bon début."
          }
        }
      }
    },
