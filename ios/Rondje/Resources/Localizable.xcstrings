        },
        "nl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Zin om vaker samen te gaan? Elke %1$@ om %2$@?"
          }
        }
      }
    },
    "Zin om weer samen op pad te gaan!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looking forward to heading out together again!"
