            "state" : "translated",
            "value" : "Sa"
          }
        }
      }
    },
    "Zachte geluidjes bij belangrijke momenten. Staat je iPhone op stil, dan hoor je niets." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soft little sounds at the moments that matter. With your iPhone on silent, you hear nothing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonidos suaves en los momentos importantes. Si tu iPhone está en silencio, no oyes nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De petits sons doux aux moments importants. Si ton iPhone est en mode silencieux, tu n'entends rien."
          }
        }
      }
    },
    "Zegt %@ ja, dan staat het rondje vast." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If %@ says yes, the walk is set."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si %@ dice que sí, el paseo queda confirmado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si %@ dit oui, la balade est confirmée."
          }
        }
      }
    },
    "Zelf iets schrijven" : {
