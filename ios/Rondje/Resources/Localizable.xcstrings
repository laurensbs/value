    "Spreek geen geld af en houd persoonlijke gegevens voor jezelf tot je elkaar kent." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't agree on money, and keep personal details to yourself until you've met."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No acordéis dinero y guarda tus datos personales hasta que os conozcáis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne parle pas d'argent et garde tes données personnelles pour toi tant que vous ne vous êtes pas rencontrés."
          }
        }
      }
    },
    "Spreek geen geld af: %@ is gratis. De eigenaar zorgt voor zakjes en koekjes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't agree on money: %@ is free. The owner provides bags and treats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No acordéis dinero: %@ es gratis. El dueño pone las bolsas y las golosinas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne parle pas d'argent : %@ est gratuit. Le propriétaire fournit les sacs et les friandises."
          }
        }
      }
    },
    "Spreek in de chat af wie wie belt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agree in the chat who calls whom."
