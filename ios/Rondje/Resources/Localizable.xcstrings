            "state" : "translated",
            "value" : "L'autre personne sera prévenue."
          }
        }
      }
    },
    "De app past zich aan wat je kiest. Je kunt dit altijd weer veranderen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app adapts to what you choose. You can always change it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app se adapta a lo que elijas. Siempre puedes cambiarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app s'adapte à ton choix. Tu peux toujours le changer."
          }
        }
      }
    },
    "De eerste keer kom je langs bij %@ en %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first time, you visit %1$@ and %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera vez, visitas a %1$@ y a %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première fois, tu passes voir %1$@ et %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "De eerste keer kom je langs bij %1$@ en %2$@."
          }
        }
      }
    },
    "De eerste keer loop je altijd samen met de eigenaar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first time, you always walk together with the owner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera vez siempre paseas junto con el dueño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première fois, tu promènes toujours avec le propriétaire."
          }
        }
      }
    },
    "De eerste keer loop je mee en bekijk je het ID." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first time you walk along and check their ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera vez caminas con él y compruebas su documento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première fois, tu marches avec lui et vérifies sa pièce d'identité."
          }
        }
      }
    },
    "De eerste keer lopen jullie samen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first time, you walk together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera vez, paseáis juntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première fois, vous marchez ensemble."
          }
        }
      }
    },
    "de eigenaar" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the owner"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "el dueño"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "le propriétaire"
          }
        }
      }
    },
    "De eigenaar bekijkt het even. %@ bewaart nooit een kopie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The owner takes a quick look. %@ never keeps a copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dueño le echa un vistazo. %@ nunca guarda una copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le propriétaire y jette un œil. %@ n'en garde jamais de copie."
          }
        }
      }
    },
    "De eigenaar beslist. Dat gaat per hond." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The owner decides. It goes dog by dog."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decide el dueño. Va perro a perro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est le propriétaire qui décide. Chien par chien."
          }
        }
      }
    },
    "De eigenaar kan live meekijken" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The owner can watch live"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dueño puede seguirlo en directo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le propriétaire peut suivre en direct"
          }
        }
      }
    },
    "De eigenaar legt zakjes klaar. Neem er gerust een paar extra mee." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The owner has bags ready. Feel free to bring a few extra."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dueño tiene bolsas preparadas. Puedes llevar alguna de más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le propriétaire prépare des sacs. N'hésite pas à en prendre quelques-uns en plus."
          }
        }
      }
    },
    "De eigenaar meteen laten weten" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let the owner know right away"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisar enseguida al dueño"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévenir tout de suite le propriétaire"
          }
        }
      }
    },
    "De eigenaar van %@ kijkt nog naar je aanvraag. Ik laat het je weten." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@'s owner is still looking at your request. I'll let you know."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dueño de %@ todavía está mirando tu solicitud. Te aviso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le maître de %@ regarde encore ta demande. Je te tiens au courant."
          }
        }
      }
    },
    "De eigenaar ziet je ID in het echt. %@ bewaart geen kopie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The owner sees your ID in person. %@ keeps no copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dueño ve tu documento en persona. %@ no guarda ninguna copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
