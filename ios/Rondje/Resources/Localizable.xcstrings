            "value" : "Harcèlement"
          }
        }
      }
    },
    "Je aanvraag voor %@ is afgewezen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your request for %@ was declined."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu solicitud para %@ ha sido rechazada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta demande pour %@ a été refusée."
          }
        }
      }
    },
    "Je account, profiel, honden, afspraken en routes worden direct en voorgoed verwijderd." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account, profile, dogs, appointments and routes will be deleted immediately and for good."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta, perfil, perros, citas y rutas se eliminarán de inmediato y para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte, ton profil, tes chiens, rendez-vous et parcours seront supprimés immédiatement et définitivement."
          }
        }
      }
    },
    "Je afspraak met %@ is geaccepteerd." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your appointment with %@ was accepted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cita con %@ ha sido aceptada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton rendez-vous avec %@ a été accepté."
          }
        }
      }
    },
    "Je bent %lld minuten over tijd. De eigenaar heeft een melding gekregen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are %lld minutes late. The owner has been notified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llevas %lld minutos de retraso. El dueño ha recibido un aviso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as %lld minutes de retard. Le propriétaire a été prévenu."
          }
        }
      }
    },
    "Je bent afgemeld" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've left"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te has dado de baja"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu t'es désinscrit·e"
          }
        }
      }
    },
    "Je doet mee! Neem je ID mee." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're in! Bring your ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Te has apuntado! Lleva tu documento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu participes ! Apporte ta pièce d'identité."
          }
        }
      }
    },
    "Je hebt al 5 open aanvragen. Wacht op antwoord of trek er een in." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You already have 5 open requests. Wait for an answer or withdraw one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya tienes 5 solicitudes abiertas. Espera respuesta o retira una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as déjà 5 demandes en cours. Attends une réponse ou retires-en une."
          }
        }
      }
    },
    "Je kiest zelf wie er komt. De eerste keer loop je samen en zie je het ID van de wandelaar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You choose who comes. The first time you walk together and see the walker's ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú eliges quién viene. La primera vez paseáis juntos y ves el documento del paseador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu choisis qui vient. La première fois, vous marchez ensemble et tu vois la pièce d'identité du promeneur."
          }
        }
      }
    },
    "Je krijgt een melding als iemand wil wandelen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll get a notification when someone wants to walk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibirás un aviso cuando alguien quiera pasear."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu reçois une notification quand quelqu'un veut promener."
          }
        }
      }
    },
    "Je kunt allebei aanzetten." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can switch on both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes activar ambas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux activer les deux."
          }
        }
      }
    },
    "Je kunt geen afspraak maken met deze persoon." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can't make an appointment with this person."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes pedir cita con esta persona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne peux pas prendre rendez-vous avec cette personne."
          }
        }
      }
    },
    "Je kunt nu geen afspraak maken met deze hond." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can't make an appointment with this dog right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora no puedes pedir cita con este perro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne peux pas prendre rendez-vous avec ce chien pour l'instant."
          }
        }
      }
    },
    "Je kunt nu zelfstandige rondjes aanvragen bij eigenaren die dat toestaan." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can now request solo walks from owners who allow it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya puedes pedir paseos en solitario a los dueños que lo permitan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux maintenant demander des balades en solo aux propriétaires qui l'autorisent."
          }
        }
      }
    },
    "Je locatie is niet beschikbaar. Vul je plaats in; dat is genoeg." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location isn't available. Enter your town; that's enough."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ubicación no está disponible. Escribe tu localidad; es suficiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta position n'est pas disponible. Indique ta ville, cela suffit."
          }
        }
      }
    },
    "Je loopt de eerste keer samen met de eigenaar. Zo leer je de hond kennen en weet iedereen waar hij aan toe is." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first time you walk together with the owner. You get to know the dog, and everyone knows where they stand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera vez paseas con el dueño. Así conoces al perro y todos saben a qué atenerse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première fois, tu marches avec le propriétaire. Tu apprends à connaître le chien et chacun sait à quoi s'attendre."
          }
        }
      }
    },
    "Je mag nu zelfstandig met %@ wandelen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You may now walk %@ on your own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya puedes pasear a %@ por tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux maintenant promener %@ seul·e."
          }
        }
      }
    },
    "Je voelt je beter dan voor het rondje. Fijn!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You feel better than before the walk. Lovely!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te sientes mejor que antes del paseo. ¡Genial!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu te sens mieux qu'avant la balade. Super !"
          }
        }
      }
    },
    "Je vriendenboek is nog leeg" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your friendship book is still empty"
