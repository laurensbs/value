    "Je aanvraag voor %@ is afgewezen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your request for %@ was declined."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu solicitud para %@ ha sido rechazada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta demande pour %@ a été refusée."
          }
        }
      }
    },
    "Je account, profiel, honden, afspraken en routes worden direct en voorgoed verwijderd." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account, profile, dogs, appointments and routes will be deleted immediately and for good."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta, perfil, perros, citas y rutas se eliminarán de inmediato y para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte, ton profil, tes chiens, rendez-vous et parcours seront supprimés immédiatement et définitivement."
          }
        }
      }
    },
    "Je afspraak met %@ is geaccepteerd." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your appointment with %@ was accepted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cita con %@ ha sido aceptada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton rendez-vous avec %@ a été accepté."
          }
        }
      }
    },
    "Je bent %lld minuten over tijd. De eigenaar heeft een melding gekregen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are %lld minutes late. The owner has been notified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llevas %lld minutos de retraso. El dueño ha recibido un aviso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as %lld minutes de retard. Le propriétaire a été prévenu."
          }
        }
      }
    },
    "Je bent afgemeld" : {
      "localizations" : {
        "en" : {
