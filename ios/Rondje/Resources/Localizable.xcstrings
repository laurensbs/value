    "Intussen kun je de Hondenschool doen. Vijf lessen van 2 minuten." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meanwhile you can do the Dog School. Five 2-minute lessons."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras tanto puedes hacer la Escuela de perros. Cinco lecciones de 2 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attendant, tu peux suivre l'École des chiens. Cinq leçons de 2 minutes."
          }
        }
      }
    },
    "Ja" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui"
          }
        }
      }
    },
    "Ja, als hij goed luistert" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes, if he listens well"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí, si obedece bien"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui, s'il obéit bien"
          }
        }
      }
    },
    "Ja, elke %@ om %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes, every %1$@ at %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí, cada %1$@ a las %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui, chaque %1$@ à %2$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ja, elke %1$@ om %2$@"
          }
        }
      }
    },
    "Ja. Door je knieën en vrolijk zijn naam roepen helpt ook." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes. Crouching down and cheerfully calling his name helps too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí. Agacharte y llamarlo alegremente también ayuda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui. S'accroupir et l'appeler joyeusement aide aussi."
          }
        }
      }
    },
    "Ja. Zijn ogen kijken weg en zijn wenkbrauwen staan bezorgd." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes. His eyes look away and his brows look worried."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí. Sus ojos miran a otro lado y sus cejas están preocupadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui. Ses yeux regardent ailleurs et ses sourcils sont inquiets."
          }
        }
      }
    },
    "Ja. Zo weet de eigenaar wie er met de hond loopt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes. That way the owner knows who is walking the dog."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí. Así el dueño sabe quién pasea al perro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui. Comme ça, le propriétaire sait qui promène le chien."
          }
        }
      }
    },
    "Je aanvraag voor %@ is afgewezen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your request for %@ was declined."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu solicitud para %@ ha sido rechazada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta demande pour %@ a été refusée."
          }
        }
      }
    },
    "Je account, profiel, honden, afspraken en routes worden direct en voorgoed verwijderd." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account, profile, dogs, appointments and routes will be deleted immediately and for good."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta, perfil, perros, citas y rutas se eliminarán de inmediato y para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte, ton profil, tes chiens, rendez-vous et parcours seront supprimés immédiatement et définitivement."
          }
        }
      }
    },
    "Je afspraak met %@ is geaccepteerd." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your appointment with %@ was accepted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cita con %@ ha sido aceptada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton rendez-vous avec %@ a été accepté."
          }
        }
      }
    },
    "Je bent %lld minuten over tijd. De eigenaar heeft een melding gekregen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are %lld minutes late. The owner has been notified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
