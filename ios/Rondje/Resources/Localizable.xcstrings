    "Ken je %@? Iemand uit de buurt loopt gratis een rondje met je hond. De eerste keer lopen jullie samen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you know %@? Someone from the neighbourhood walks your dog for free. The first time, you walk together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Conoces %@? Alguien del barrio pasea a tu perro gratis. La primera vez, paseáis juntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu connais %@ ? Quelqu'un du quartier promène ton chien gratuitement. La première fois, vous marchez ensemble."
          }
        }
      }
    },
