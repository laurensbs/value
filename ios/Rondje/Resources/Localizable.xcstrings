        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Super, à bientôt !"
          }
        }
      }
    },
    "Leuk! Wanneer kun je kennismaken?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
