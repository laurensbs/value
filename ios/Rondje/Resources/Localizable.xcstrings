            "state" : "translated",
            "value" : "Petite pause"
          }
        }
      }
    },
    "Even samen op een bankje zitten telt ook. Rondjes hoeven niet snel of ver te zijn." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitting on a bench together counts too. Walks don't have to be fast or far."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentarse juntos en un banco también cuenta. Los paseos no tienen que ser rápidos ni largos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'asseoir ensemble sur un banc compte aussi. Les balades n'ont pas besoin d'être rapides ou longues."
          }
        }
      }
    },
    "Even voor jezelf: hoe voel je je nu?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just for you: how do you feel right now?"
