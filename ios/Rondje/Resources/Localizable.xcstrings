    "Voor jezelf, de buren of opa en oma" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For yourself, the neighbours or the grandparents"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ti, los vecinos o los abuelos"
