      }
    },
    "Je locatie is niet beschikbaar. Vul je plaats in; dat is genoeg." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location isn't available. Enter your town; that's enough."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ubicación no está disponible. Escribe tu localidad; es suficiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta position n'est pas disponible. Indique ta ville, cela suffit."
          }
        }
      }
    },
    "Je loopt de eerste keer samen met de eigenaar. Zo leer je de hond kennen en weet iedereen waar hij aan toe is." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first time you walk together with the owner. You get to know the dog, and everyone knows where they stand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera vez paseas con el dueño. Así conoces al perro y todos saben a qué atenerse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première fois, tu marches avec le propriétaire. Tu apprends à connaître le chien et chacun sait à quoi s'attendre."
          }
        }
      }
    },
    "Je loopt later terug dan afgesproken. Wat doe je?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're coming back later than agreed. What do you do?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelves más tarde de lo acordado. ¿Qué haces?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu rentres plus tard que prévu. Que fais-tu ?"
          }
        }
      }
    },
    "Je mag nu zelfstandig met %@ wandelen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You may now walk %@ on your own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya puedes pasear a %@ por tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux maintenant promener %@ seul·e."
          }
        }
      }
    },
    "Je melding is binnen. Iemand van %@ neemt contact op als dat nodig is." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your report is in. Someone from %@ will get in touch if needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu aviso ha llegado. Alguien de %@ se pondrá en contacto si hace falta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton signalement est bien arrivé. Quelqu'un de %@ te contactera si nécessaire."
          }
        }
      }
    },
    "Je punten tellen we zodra je weer verbinding hebt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll count your points as soon as you're back online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contamos tus puntos en cuanto vuelvas a tener conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On compte tes points dès que tu es de nouveau connecté."
          }
        }
      }
    },
    "Je route wordt niet bijgehouden of gedeeld. De tijd, het rondje-rapport en foto's werken gewoon." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your route is not tracked or shared. The time, the walk report and photos work as usual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu recorrido no se registra ni se comparte. El tiempo, el informe del paseo y las fotos funcionan como siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton trajet n'est ni suivi ni partagé. Le temps, le compte rendu de la balade et les photos fonctionnent comme d'habitude."
          }
        }
      }
    },
    "Je seintjes staan even op pauze." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your nudges are paused for now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus avisos están en pausa por ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes petits rappels sont en pause pour l'instant."
          }
        }
      }
    },
    "Je vinkjes blijven op je telefoon." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your ticks stay on your phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus marcas se quedan en tu móvil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes coches restent sur ton téléphone."
          }
        }
      }
    },
    "Je voelt je beter dan voor het rondje. Fijn!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You feel better than before the walk. Lovely!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te sientes mejor que antes del paseo. ¡Genial!"
          }
        },
