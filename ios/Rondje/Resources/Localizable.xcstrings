          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu vois Bobbie pour la première fois. Que fais-tu ?"
          }
        }
      }
    },
    "Je ziet honden in de buurt en plant rondjes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You see dogs nearby and plan walks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ves perros cerca y planificas paseos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu vois les chiens du quartier et prévois des balades."
          }
        }
      }
    },
    "Je ziet live waar ze lopen. Foto's en plasjes komen hier vanzelf binnen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You see live where they're walking. Photos and pees show up here by themselves."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ves en directo por dónde van. Las fotos y los pis llegan aquí solos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu vois en direct où ils marchent. Les photos et les pipis arrivent ici tout seuls."
          }
        }
      }
    },
    "Je ziet wie met je hond wil wandelen, en kijkt live mee." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You see who wants to walk your dog, and watch along live."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ves quién quiere pasear a tu perro y lo sigues en directo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu vois qui veut promener ton chien et tu suis en direct."
          }
        }
      }
    },
    "Jij" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You"
          }
        },
        "es" : {
