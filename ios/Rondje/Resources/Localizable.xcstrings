    "Wegdraaien is een beleefde manier om nee te zeggen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turning away is a polite way of saying no."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apartarse es una forma educada de decir que no."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se détourner, c'est une façon polie de dire non."
          }
        }
      }
    },
    "Weglopen helpt niemand. De andere eigenaar heeft je gegevens nodig." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walking away helps no one. The other owner needs your details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irte no ayuda a nadie. El otro dueño necesita tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partir n'aide personne. L'autre propriétaire a besoin de tes coordonnées."
