    "Zelfstandig wandelen kun je later altijd nog toestaan." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can always allow walks on their own later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre puedes permitir paseos por su cuenta más adelante."
