          "stringUnit" : {
            "state" : "translated",
            "value" : "Ears back and a low tail? Give the dog some space and talk calmly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Orejas hacia atrás y cola baja? Dale espacio al perro y habla con calma."
