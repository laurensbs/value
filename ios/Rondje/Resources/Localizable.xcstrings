          }
        }
      }
    },
    "Je ziet Bobbie voor het eerst. Wat doe je?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You see Bobbie for the first time. What do you do?"
