    "Wil je een rustig seintje op een vast moment? Jij kiest wanneer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Would you like a calm nudge at a set moment? You choose when."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres un aviso tranquilo en un momento fijo? Tú eliges cuándo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu veux un petit rappel tranquille à un moment fixe ? C'est toi qui choisis quand."
          }
        }
