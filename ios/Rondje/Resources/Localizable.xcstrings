          }
        }
      }
    },
    "Ik wandel graag in het park." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I like walking in the park."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me gusta pasear por el parque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'aime me promener au parc."
          }
        }
      }
    },
    "Ik wandel met honden uit de buurt via %@. Gratis, en je helpt er iemand mee. Doe je mee?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I walk dogs from the neighbourhood with %@. It's free, and you help someone. Want to join?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paseo perros del barrio con %@. Es gratis y ayudas a alguien. ¿Te apuntas?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je promène des chiens du quartier avec %@. C'est gratuit, et tu aides quelqu'un. Tu viens ?"
          }
        }
      }
    },
    "Ik wil wandelen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I want to walk"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiero pasear"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je veux promener"
          }
        }
      }
    },
    "Ik zoek een paar honden voor je uit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'm picking a few dogs for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estoy buscando unos perros para ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je te cherche quelques chiens."
          }
        }
      }
    },
    "Ik zou %@ graag leren kennen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'd love to meet %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me encantaría conocer a %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'aimerais beaucoup rencontrer %@."
          }
        }
      }
    },
    "Ik zou het weer doen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would do it again"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo volvería a hacer"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je le referais"
          }
        }
      }
    },
    "In de winter prikt strooizout in pootjes. Even afvegen na het rondje." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In winter, road salt stings paws. Give them a quick wipe after the walk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En invierno, la sal de las calles pica en las patas. Límpialas tras el paseo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hiver, le sel de déneigement pique les pattes. Essuie-les après la balade."
          }
        }
      }
    },
    "In het donker? Een lampje aan de riem maakt jullie allebei beter zichtbaar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the dark? A light on the leash makes you both easier to see."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿De noche? Una luz en la correa os hace más visibles a los dos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans le noir ? Une lampe sur la laisse vous rend tous les deux plus visibles."
          }
        }
      }
    },
    "In Spanje mag je een PPP-hond alleen uitlaten met een geldige licentie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Spain you may only walk a PPP dog with a valid licence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En España solo puedes pasear un perro PPP con una licencia válida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Espagne, tu ne peux promener un chien PPP qu'avec une licence valide."
          }
        }
      }
    },
