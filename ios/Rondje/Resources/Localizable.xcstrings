        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne peux pas prendre rendez-vous avec cette personne."
          }
        }
      }
    },
    "Je kunt nu geen afspraak maken met deze hond." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can't make an appointment with this dog right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora no puedes pedir cita con este perro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne peux pas prendre rendez-vous avec ce chien pour l'instant."
          }
        }
      }
    },
    "Je kunt nu zelfstandige rondjes aanvragen bij eigenaren die dat toestaan." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can now request solo walks from owners who allow it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya puedes pedir paseos en solitario a los dueños que lo permitan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux maintenant demander des balades en solo aux propriétaires qui l'autorisent."
          }
        }
      }
    },
    "Je locatie is niet beschikbaar. Vul je plaats in; dat is genoeg." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location isn't available. Enter your town; that's enough."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ubicación no está disponible. Escribe tu localidad; es suficiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta position n'est pas disponible. Indique ta ville, cela suffit."
          }
        }
      }
    },
    "Je mag nu zelfstandig met %@ wandelen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You may now walk %@ on your own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
