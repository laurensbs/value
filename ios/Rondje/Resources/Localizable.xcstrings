    "Alleen %@ ziet dit, nooit de ander." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only %@ sees this, never the other person."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo %@ ve esto, nunca la otra persona."
          }
        },
