    "Snuffelen is voor een hond net zo vermoeiend als rennen. Een rustig snuffelrondje is een cadeau." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sniffing tires a dog as much as running. A calm sniffing walk is a gift."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olfatear cansa a un perro tanto como correr. Un paseo tranquilo olfateando es un regalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renifler fatigue un chien autant que courir. Une balade tranquille à renifler est un cadeau."
          }
        }
      }
    },
