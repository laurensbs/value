    "Precies!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exactly!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Exacto!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exactement !"
          }
        }
      }
    },
    "Precies! Zo weet hij wie je bent." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exactly! That way he knows who you are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Exacto! Así sabe quién eres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exactement ! Comme ça, il sait qui tu es."
          }
        }
      }
    },
    "Precies. Bij twijfel blijft hij aan de lijn." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exactly. When in doubt, he stays on the lead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exacto. Si dudas, sigue con correa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exactement. En cas de doute, il reste en laisse."
          }
        }
      }
    },
    "Precies. Even laten weten is altijd goed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exactly. Letting them know is always good."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exacto. Avisar siempre está bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exactement. Prévenir, c'est toujours bien."
          }
        }
      }
    },
    "Precies. Kort, koel en met water." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exactly. Short, cool and with water."
          }
