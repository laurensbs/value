    "Neem op warme dagen water mee, en voel met je hand of de stoep niet te heet is voor zijn pootjes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On warm days bring water, and feel with your hand whether the pavement is too hot for their paws."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En días de calor lleva agua y comprueba con la mano que la acera no quema sus patas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par temps chaud, emporte de l'eau et vérifie avec ta main que le trottoir n'est pas trop chaud pour ses pattes."
          }
        }
      }
    },
