    "Bobbie draait zijn kop weg als je hem aait. Wat betekent dat?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bobbie turns his head away when you pet him. What does that mean?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bobbie aparta la cabeza cuando lo acaricias. ¿Qué significa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bobbie détourne la tête quand tu le caresses. Qu'est-ce que ça veut dire ?"
          }
        }
      }
    },
