    "We maken hier nog afspraken over. Zodra die rond zijn, zie je hier precies waar je bijdrage heen gaat." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We're still making arrangements about this. Once they're settled, you'll see here exactly where your contribution goes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía lo estamos acordando. En cuanto esté cerrado, verás aquí exactamente adónde va tu aportación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous sommes encore en train d'en discuter. Dès que ce sera conclu, tu verras ici exactement où va ta contribution."
          }
        }
      }
    },
