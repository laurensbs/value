    },
    "Je hebt al 5 open aanvragen. Wacht op antwoord of trek er een in." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You already have 5 open requests. Wait for an answer or withdraw one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya tienes 5 solicitudes abiertas. Espera respuesta o retira una."
