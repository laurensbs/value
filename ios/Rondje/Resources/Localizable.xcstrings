    "Vaste momenten werken het best. Je hond gaat er zelfs naar uitkijken." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regular times work best. Your dog will even look forward to them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los horarios fijos funcionan mejor. Tu perro hasta los esperará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les créneaux fixes marchent le mieux. Ton chien va même les attendre."
