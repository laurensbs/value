          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación en directo está desactivada por ahora, así que todavía no empieza un paseo a solas con el perro. Pasear junto con el dueño sí es posible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
