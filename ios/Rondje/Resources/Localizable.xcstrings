    "Jullie lopen samen een rondje. De eigenaar loopt mee en bekijkt je ID." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You go for a walk together. The owner comes along and checks your ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dais un paseo juntos. El dueño os acompaña y comprueba tu documento de identidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous faites une balade ensemble. Le propriétaire vous accompagne et vérifie ta pièce d'identité."
          }
        }
      }
    },
    "Jullie lopen samen, dus er is geen kaart nodig." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're walking together, so there's no need for a map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paseáis juntos, así que no hace falta mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous vous promenez ensemble, donc pas besoin de carte."
          }
        }
      }
    },
    "Jullie lopen samen. Daarna beslist de eigenaar of je zelfstandig met %@ mag." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You walk together. Afterwards the owner decides whether you may walk %@ on your own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paseáis juntos. Después, el dueño decide si puedes pasear a %@ por tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous marchez ensemble. Ensuite, le propriétaire décide si tu peux promener %@ seul."
          }
        }
      }
    },
    "Jullie lopen voorlopig samen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For now, you walk together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por ahora, paseáis juntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour l'instant, vous marchez ensemble."
          }
        }
