    "Vijf korte lessen over veilig wandelen. Elk ongeveer 2 minuten." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Five short lessons about walking safely. About 2 minutes each."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinco lecciones cortas sobre pasear con seguridad. Unos 2 minutos cada una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinq courtes leçons pour promener en sécurité. Environ 2 minutes chacune."
          }
        }
      }
    },
    "Voel met je hand of de stoep niet te heet is." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feel with your hand whether the pavement isn't too hot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el suelo con la mano para ver que no quema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie avec ta main que le trottoir n'est pas trop chaud."
          }
        }
      }
    },
    "Voelde het goed? Dan kan de eigenaar je vertrouwen geven voor zelfstandige rondjes. Je hoort het vanzelf." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did it feel good? Then the owner can trust you with walks on your own. You'll hear about it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te sentiste bien? Entonces el dueño puede confiarte paseos por tu cuenta. Ya te avisaremos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça s'est bien passé ? Le propriétaire peut alors te faire confiance pour des balades en solo. Tu seras prévenu."
          }
        }
      }
    },
    "Voelde het goed? Tik dan op Vertrouwen. Pas daarna mag %@ zelfstandig." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did it feel right? Then tap Trust. Only then may %@ walk on their own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te ha dado buena sensación? Toca Confianza. Solo entonces %@ puede pasear por su cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça s'est bien passé ? Touche alors Confiance. Ce n'est qu'ensuite que %@ peut promener seul."
          }
        }
      }
    },
