        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cuenta es gratis y lo seguirá siendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compte est gratuit et le restera."
          }
        }
      }
    },
    "Een andere hond komt eraan? Vraag de eigenaar eerst of ze kennis mogen maken." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another dog coming? Ask its owner first whether they may say hello."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Viene otro perro? Pregunta primero al dueño si pueden saludarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un autre chien arrive ? Demande d'abord à son propriétaire s'ils peuvent se saluer."
          }
        }
      }
    },
    "Een beet of gevecht" : {
      "localizations" : {
