    "Tijdens het rondje staat SOS altijd rechtsboven. Daar vind je 112, de eigenaar en de dierenarts." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During the walk, SOS is always at the top right. There you'll find 112, the owner and the vet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante el paseo, SOS está siempre arriba a la derecha. Ahí encuentras el 112, el dueño y el veterinario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la balade, SOS est toujours en haut à droite. Tu y trouves le 112, le propriétaire et le vétérinaire."
          }
        }
      }
    },
    "Tijdens het rondje staat SOS rechtsboven." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During the walk, SOS is at the top right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante el paseo, SOS está arriba a la derecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la balade, SOS est en haut à droite."
          }
        }
      }
    },
    "Tijdens het rondje zie je waar ze lopen, krijg je een foto, en hoor je of je hond heeft geplast." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During the walk you see where they are, get a photo, and hear whether your dog has peed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante el paseo ves dónde están, recibes una foto y sabes si tu perro ha hecho pis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la balade, tu vois où ils sont, tu reçois une photo et tu sais si ton chien a fait pipi."
          }
        }
      }
    },
