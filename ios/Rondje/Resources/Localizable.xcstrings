    },
    "Ik sta bij de voordeur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'll be at the front door."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estaré en la puerta de entrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je serai à la porte d'entrée."
          }
        }
      }
    },
    "Ik stuur je alleen een seintje op een moment dat jij kiest. Hooguit zo vaak als jij wilt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I only nudge you at a moment you choose. Never more often than you want."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo te aviso en el momento que tú elijas. Nunca más a menudo de lo que quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je t'envoie un petit rappel seulement au moment que tu choisis. Jamais plus souvent que tu ne veux."
          }
        }
      }
    },
    "Ik stuur je even geen seintjes meer. Aanzetten kan altijd bij Jij, Seintjes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'll stop sending nudges for now. You can always turn them on in You, Nudges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejo de enviarte avisos por ahora. Siempre puedes activarlos en Tú, Avisos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je n'envoie plus de rappels pour l'instant. Tu peux toujours les réactiver dans Toi, Petits rappels."
          }
        }
      }
    },
    "Ik voelde me veilig" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I felt safe"
          }
