            "value" : "Vérifier"
          }
        }
      }
    },
    "Daar knapt %@ van op." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ really enjoyed that."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %@ le ha sentado de maravilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça a fait du bien à %@."
          }
        }
      }
    },
    "Daarna kun je een kennismaking aanvragen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then you can ask to meet a dog."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después puedes pedir un encuentro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensuite, tu peux demander une rencontre."
          }
        }
      }
    },
    "Daarna mag de wandelaar zelfstandig met je hond." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After that the walker may take your dog out alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después el paseador puede salir solo con tu perro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensuite, le promeneur peut sortir ton chien seul."
          }
        }
      }
    },
    "Daarna wandel je zelfstandig. De eigenaar kijkt live mee, en jij stuurt een foto of een plasje door." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After that you walk on your own. The owner watches live, and you send a photo or a pee update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después paseas por tu cuenta. El dueño lo sigue en directo y tú envías una foto o un pis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensuite tu te promènes seul·e. Le propriétaire suit en direct, et tu envoies une photo ou un pipi."
          }
        }
      }
    },
    "Dan laten we je precies zien wat voor jou belangrijk is." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then we'll show you exactly what matters to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así te mostramos justo lo que te importa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainsi, nous te montrons exactement ce qui compte pour toi."
          }
        }
      }
    },
    "Dank je dat je het vertelt. Iemand van %@ kijkt ernaar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thank you for telling us. Someone from %@ will look into it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias por contárnoslo. Alguien de %@ lo revisará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci de nous l'avoir dit. Quelqu'un de %@ va s'en occuper."
          }
        }
      }
    },
    "Dank je wel namens %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thank you from %@."
          }
