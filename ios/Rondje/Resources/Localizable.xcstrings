          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu reçois une notification quand quelqu'un veut promener."
          }
        }
      }
    },
    "Je krijgt een melding zodra %@ antwoordt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll get a notification as soon as %@ replies."
