    "Leuk, tot dan!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Great, see you then!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
