    "Of ik regel het voor een buurvrouw, opa of oma." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or I arrange it for a neighbour or a grandparent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O lo gestiono para una vecina, un abuelo o una abuela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou je m'en occupe pour une voisine, un grand-père ou une grand-mère."
          }
        }
      }
    },
    "Of ik zoek hulp voor de hond van een buurvrouw, opa of oma." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or I'm looking for help for a neighbour's or grandparent's dog."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O busco ayuda para el perro de una vecina o un abuelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou je cherche de l'aide pour le chien d'une voisine ou d'un grand-parent."
          }
        }
      }
    },
