          }
        }
      }
    },
    "Ik houd me aan de gedragscode: aan de lijn, geen koekjes zonder toestemming, en ik meld het meteen als er iets gebeurt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I follow the code of conduct: on the leash, no treats without permission, and I report it right away if something happens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumplo el código de conducta: con correa, sin golosinas sin permiso, y aviso enseguida si pasa algo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je respecte le code de conduite : en laisse, pas de friandises sans autorisation, et je signale immédiatement s'il se passe quelque chose."
          }
        }
      }
    },
    "Ik voelde me veilig" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I felt safe"
          }
        },
