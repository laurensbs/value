        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsafe"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inseguro"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dangereux"
          }
        }
      }
    },
    "Ook een hond die goed luistert blijft aan de lijn, tenzij de eigenaar iets anders zegt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even a dog that listens well stays on the lead, unless the owner says otherwise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluso un perro que obedece bien va con correa, salvo que el dueño diga otra cosa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même un chien qui obéit bien reste en laisse, sauf si le propriétaire dit autre chose."
          }
        }
      }
    },
    "Op de dag zelf start je het rondje bij Afspraken." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the day itself, you start the walk in Appointments."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mismo día, empiezas el paseo en Citas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jour même, tu lances la balade dans Rendez-vous."
          }
        }
      }
    },
    "Op de dag zelf start je hier je rondje. Een half uur van tevoren mag het al." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the day itself you start your walk here. You can already do so half an hour before."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mismo día empiezas aquí tu paseo. Ya puedes hacerlo media hora antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jour même, tu lances ta balade ici. Tu peux déjà le faire une demi-heure avant."
          }
        }
      }
    },
    "Op tijd terug" : {
      "localizations" : {
