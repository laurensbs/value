      }
    },
    "Alleen %@ ziet je antwoord." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only %@ sees your answer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo %@ ve tu respuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul %@ voit ta réponse."
          }
        }
      }
    },
    "Alleen als de eigenaar het uitdrukkelijk zegt, en alleen waar het mag" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only if the owner explicitly says so, and only where it's allowed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo si el dueño lo dice claramente, y solo donde está permitido"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement si le propriétaire le dit clairement, et seulement là où c'est permis"
          }
        }
      }
    },
    "Alleen als het goed voelde, geef je vertrouwen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only give your trust if it felt right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da tu confianza solo si te sentiste bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne donne ta confiance que si tu l'as bien senti."
          }
        }
      }
    },
    "Alleen koekjes van de eigenaar" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the owner's treats"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo las golosinas del dueño"
