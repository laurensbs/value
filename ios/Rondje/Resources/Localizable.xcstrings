          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne peux pas prendre rendez-vous avec cette personne."
          }
        }
      }
    },
    "Je kunt live meekijken zodra het rondje start." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can watch live as soon as the walk starts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes seguirlo en directo en cuanto empiece el paseo."
          }
