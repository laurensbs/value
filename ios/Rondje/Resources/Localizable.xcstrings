    },
    "Je hebt het ID van %@ gezien." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've seen %@'s ID."
          }
        },
        "es" : {
          "stringUnit" : {
