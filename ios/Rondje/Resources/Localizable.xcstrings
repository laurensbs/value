          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu participes ! Apporte ta pièce d'identité."
          }
        }
      }
    },
    "Je hebt al 5 open aanvragen. Wacht op antwoord of trek er een in." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You already have 5 open requests. Wait for an answer or withdraw one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya tienes 5 solicitudes abiertas. Espera respuesta o retira una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as déjà 5 demandes en cours. Attends une réponse ou retires-en une."
          }
        }
      }
    },
    "Je kunt allebei aanzetten." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can switch on both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes activar ambas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux activer les deux."
          }
        }
      }
    },
    "Je kunt geen afspraak maken met deze persoon." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can't make an appointment with this person."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes pedir cita con esta persona."
