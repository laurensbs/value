    "Leg zakjes, riem en een koekje klaar bij de deur. Dan is de overdracht zo gedaan." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put bags, leash and a treat by the door. Then the handover is quick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja bolsas, correa y una golosina junto a la puerta. Así la entrega es rápida."
          }
