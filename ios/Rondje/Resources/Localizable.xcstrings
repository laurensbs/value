    "Goed gezien. Luisteren naar een hond is de helft van het werk." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Well spotted. Listening to a dog is half the work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien visto. Escuchar a un perro es la mitad del trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien vu. Écouter un chien, c'est la moitié du travail."
          }
        }
      }
    },
    "Goed om te weten" : {
