            "value" : "Lire tout le code de conduite"
          }
        }
      }
    },
    "Lees de volledige voorwaarden" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read the full terms"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer las condiciones completas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lire les conditions complètes"
          }
        }
      }
    },
    "Lees in rust wat er verandert." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take your time to read what changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee con calma lo que cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prends le temps de lire ce qui change."
          }
        }
      }
    },
    "Lees in rust wat er verandert. De nieuwe voorwaarden gelden voor jou vanaf %@. Vanaf dan vragen we eerst je akkoord, voordat je iets nieuws afspreekt of een rondje start." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take your time to read what changes. The new terms apply to you from %@. From then on, we ask for your agreement first, before you arrange something new or start a walk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee con calma lo que cambia. Las nuevas condiciones se aplican para ti a partir del %@. A partir de entonces, te pedimos primero tu aceptación, antes de quedar para algo nuevo o empezar un paseo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prends le temps de lire ce qui change. Les nouvelles conditions s'appliquent pour toi à partir du %@. Dès lors, nous te demandons d'abord ton accord, avant de convenir de quelque chose de nouveau ou de commencer une balade."
          }
        }
      }
    },
    "Lees wat er verandert" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read what changes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer qué cambia"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lire ce qui change"
          }
        }
      }
    },
    "Lees wat er verandert. Na je akkoord kun je weer afspraken maken en rondjes starten." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read what changes. Once you agree, you can make appointments and start walks again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee lo que cambia. Cuando las aceptes, podrás volver a quedar y empezar paseos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lis ce qui change. Une fois que tu les acceptes, tu peux à nouveau prendre rendez-vous et commencer des balades."
          }
        }
      }
    },
    "Leg je hand plat op de stoep. Houd hem er 7 seconden op." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put your hand flat on the pavement. Hold it there for 7 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon la mano plana sobre la acera. Mantenla 7 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose ta main à plat sur le trottoir. Garde-la 7 secondes."
          }
        }
      }
    },
    "Leg je ID alvast klaar. Tik om je voor te bereiden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put your ID out ready. Tap to get prepared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja tu documento preparado. Toca para prepararte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prépare déjà ta pièce d'identité. Touche pour te préparer."
          }
        }
      }
    },
    "Leg riem en zakjes klaar, en vraag naar het ID." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put the leash and bags out, and ask to see the ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepara la correa y las bolsas, y pide el documento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prépare la laisse et les sacs, et demande la pièce d'identité."
          }
        }
      }
    },
    "Leg zakjes, riem en een koekje klaar bij de deur. Dan is de overdracht zo gedaan." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put bags, leash and a treat by the door. Then the handover is quick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja bolsas, correa y una golosina junto a la puerta. Así la entrega es rápida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prépare sacs, laisse et une friandise près de la porte. La remise sera rapide."
          }
        }
      }
    },
    "Lekker doorlopen naar de drukte" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep walking into the crowd"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir hacia el bullicio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuer vers la foule"
          }
        }
      }
    },
    "Lekker rennen, dan is het snel klaar" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A good run, then it's over quickly"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correr, así se acaba antes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Courir, comme ça c'est vite fini"
          }
        }
      }
    },
    "Les klaar!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lesson done!"
          }
