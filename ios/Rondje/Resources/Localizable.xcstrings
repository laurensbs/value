    "Contactgegevens en afspreekplek zie je pas als je afspraak is geaccepteerd." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll see contact details and the meeting point once your appointment is accepted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verás los datos de contacto y el punto de encuentro cuando tu cita sea aceptada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu verras les coordonnées et le lieu de rendez-vous une fois ton rendez-vous accepté."
          }
        }
      }
    },
    "Controleer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check"
          }
        },
        "es" : {
