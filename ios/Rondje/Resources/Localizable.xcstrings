            "value" : "Il y a une nouvelle balade de groupe dans un refuge."
          }
        }
      }
    },
    "Er komen steeds meer honden bij. Kijk later nog eens, of tip een opvang op de website." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More dogs join all the time. Check back later, or suggest a shelter on the website."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez hay más perros. Vuelve más tarde o sugiere un refugio en la web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De plus en plus de chiens arrivent. Reviens plus tard ou suggère un refuge sur le site."
          }
        }
      }
    },
    "Er wacht een hond op je" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A dog is waiting for you"
          }
