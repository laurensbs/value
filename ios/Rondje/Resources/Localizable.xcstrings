      }
    },
    "Zachte geluidjes bij belangrijke momenten. Staat je iPhone op stil, dan hoor je niets." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soft little sounds at the moments that matter. With your iPhone on silent, you hear nothing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonidos suaves en los momentos importantes. Si tu iPhone está en silencio, no oyes nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De petits sons doux aux moments importants. Si ton iPhone est en mode silencieux, tu n'entends rien."
          }
        }
      }
    },
    "Zelfstandig rondje" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo walk"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paseo en solitario"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balade en solo"
          }
        }
      }
    },
    "Zelfstandig, want de eigenaar vertrouwt je." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your own, because the owner trusts you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por tu cuenta, porque el dueño confía en ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul·e, car le propriétaire te fait confiance."
          }
        }
      }
    },
    "Zet je hond erop" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your dog"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu perro"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute ton chien"
          }
        }
      }
    },
    "Zet je hond erop, of die van een buurvrouw, opa of oma die zelf niet ver meer kan lopen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your dog, or one of a neighbour or grandparent who can't walk far any more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu perro, o el de una vecina o un abuelo que ya no puede caminar mucho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute ton chien, ou celui d'une voisine ou d'un grand-parent qui ne peut plus marcher loin."
          }
        }
      }
    },
    "Zo houden we het veilig" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How we keep it safe"
          }
