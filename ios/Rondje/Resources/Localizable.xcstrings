          }
        }
      }
    },
    "Een hond die ooit beet, is alleen voor wandelaars met ervaring." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A dog that has ever bitten is only for experienced walkers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un perro que alguna vez mordió es solo para paseadores con experiencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un chien qui a déjà mordu est réservé aux promeneurs expérimentés."
          }
        }
      }
    },
    "Een mens van %@ leest elke melding. Bij direct gevaar: bel 112." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A person at %@ reads every report. In immediate danger: call 112."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una persona de %@ lee cada aviso. En caso de peligro inmediato: llama al 112."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une personne de %@ lit chaque signalement. En cas de danger immédiat : appelle le 112."
          }
        }
      }
    },
    "Een rustig doel voor jezelf. Haal je het een week niet, dan is er niets verloren." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A calm goal for yourself. Miss it one week and nothing is lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una meta tranquila para ti. Si no la cumples una semana, no pierdes nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un objectif tranquille pour toi. Si tu le rates une semaine, rien n'est perdu."
          }
        }
      }
    },
    "Eerlijk is veilig" : {
      "localizations" : {
