    "Optillen is spannend voor een hond die je nog niet kent." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Being picked up is scary for a dog that doesn't know you yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que lo cojan en brazos asusta a un perro que aún no te conoce."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Être soulevé, c'est stressant pour un chien qui ne te connaît pas encore."
