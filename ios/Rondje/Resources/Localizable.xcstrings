    "Voor mensen met een depressie en hun naasten. Wandelen met een hond helpt tegen somberheid." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For people with depression and their loved ones. Walking with a dog helps against low mood."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para personas con depresión y sus allegados. Pasear con un perro ayuda contra el desánimo."
