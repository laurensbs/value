            "value" : "Di"
          }
        }
      }
    },
    "Zo ben je er klaar voor. Tik af wat je hebt gedaan." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is how you get ready. Tick off what you've done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así estarás listo. Marca lo que ya has hecho."
