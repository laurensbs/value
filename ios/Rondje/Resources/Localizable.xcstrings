    "Gapen, lippen likken en wegkijken betekenen vaak: ik voel me niet op mijn gemak." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yawning, licking lips and looking away often mean: I don't feel at ease."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bostezar, lamerse los labios y apartar la mirada suele significar: no estoy a gusto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bâiller, se lécher les babines et détourner le regard veulent souvent dire : je ne suis pas à l'aise."
          }
        }
      }
    },
