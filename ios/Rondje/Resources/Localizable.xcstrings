    "Veel gapen, lippen likken en wegtrekken betekent: ik voel me niet op mijn gemak. Zoek een rustigere plek." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lots of yawning, lip licking and pulling away means: I don't feel at ease. Find a quieter spot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bostezar mucho, lamerse los labios y tirar hacia atrás significa: no estoy a gusto. Busca un sitio más tranquilo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bâiller souvent, se lécher les babines et tirer pour s'éloigner veut dire : je ne suis pas à l'aise. Cherche un endroit plus calme."
          }
        }
      }
    },
    "Veilig op bezoek: spreek overdag af, laat iemand weten waar je bent, en familie of een buur mag er gerust bij zijn." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visiting safely: meet during the day, let someone know where you are, and family or a neighbour are welcome to join."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una visita segura: quedad de día, avisa a alguien de dónde estás, y la familia o un vecino pueden estar presentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une visite en toute sécurité : rencontrez-vous en journée, préviens quelqu'un de l'endroit où tu es, et la famille ou un voisin peuvent être présents."
          }
        }
      }
    },
    "Veilig op bezoek: spreek overdag af, laat iemand weten waar je bent, en familie of een buur mag er gerust bij zijn. Het adres en het telefoonnummer zie je pas na acceptatie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visiting safely: meet during the day, let someone know where you are, and family or a neighbour are welcome to join. You only see the address and phone number once accepted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una visita segura: quedad de día, avisa a alguien de dónde estás, y la familia o un vecino pueden estar presentes. La dirección y el teléfono solo los ves cuando se acepte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une visite en toute sécurité : rencontrez-vous en journée, préviens quelqu'un de l'endroit où tu es, et la famille ou un voisin peuvent être présents. Tu ne vois l'adresse et le téléphone qu'une fois accepté."
          }
        }
      }
    },
