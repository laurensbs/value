            "value" : "Todavía no tengo experiencia con perros, pero me encanta aprender."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je n'ai pas encore d'expérience avec les chiens, mais j'apprends volontiers."
          }
        }
      }
    },
    "Ik heb twee honden voor je uitgezocht." : {
