          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci de la part de %@."
          }
        }
      }
    },
    "Dank je wel voor het vertrouwen!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks for trusting me!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
