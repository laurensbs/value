    "Klopt. Stap voor stap, voor iedereen veilig." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right. Step by step, safe for everyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correcto. Paso a paso, seguro para todos."
          }
        },
        "fr" : {
