        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pourras toujours autoriser les balades en solo plus tard."
          }
        }
      }
    },
    "Zet je hond erop" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your dog"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu perro"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute ton chien"
          }
        }
      }
    },
    "Zet je hond erop, of die van een buurvrouw, opa of oma die zelf niet ver meer kan lopen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your dog, or one of a neighbour or grandparent who can't walk far any more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu perro, o el de una vecina o un abuelo que ya no puede caminar mucho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute ton chien, ou celui d'une voisine ou d'un grand-parent qui ne peut plus marcher loin."
          }
        }
      }
    },
    "Zet je hond erop. Ik help je stap voor stap." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your dog. I'll help you step by step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade a tu perro. Te ayudo paso a paso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute ton chien. Je t'aide pas à pas."
          }
        }
      }
    },
    "Zin in een rondje met %@? Je kunt het de eigenaar vragen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fancy a walk with %@? You can ask the owner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te apetece un paseo con %@? Puedes pedírselo al dueño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie d'une balade avec %@ ? Tu peux le demander au propriétaire."
          }
        }
      }
    },
    "Zin om dit vaker te doen? Vaste momenten werken het best." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fancy doing this more often? Regular times work best."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te apetece hacerlo más a menudo? Los momentos fijos funcionan mejor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie de recommencer plus souvent ? Les moments fixes marchent le mieux."
          }
        }
      }
    },
    "Zin om vaker samen te gaan? Elke %@ om %@?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fancy walking together more often? Every %@ at %@?"
